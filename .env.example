# Copy to .env. Never commit .env.
# Free-tier key from https://openrouter.ai/keys — completions 401 without it.
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Must be an id listed in models.allowlist. openrouter/free mixes free models.
OPENROUTER_MODEL=openrouter/free

# OpenRouter asks for these on every request.
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=systems-learning-lab-shopkeeper

# Local Phoenix. Not a secret. Counter still runs if this is down.
PHOENIX_OTLP=http://localhost:6006/v1/traces
