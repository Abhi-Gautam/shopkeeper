# Copy to .env. Never commit .env.
# The names say OPENROUTER for history; the counter talks to OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.openai.com/v1

OPENROUTER_MODEL=gpt-6-luna
# none | low | medium | high. Empty sends nothing (the model's default).
OPENROUTER_REASONING_EFFORT=low

# Local Phoenix. Not a secret. The counter still sells if this is down.
PHOENIX_OTLP=http://localhost:6006/v1/traces
PHOENIX_PROJECT=shopkeeper
