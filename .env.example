# Copy to .env. Never commit .env.
# Free-tier key from https://openrouter.ai/keys — completions 401 without it.
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Must be an id listed in models.allowlist. openrouter/free mixes free models.
# For evals, call OpenAI directly with an OpenAI key in OPENROUTER_API_KEY.
# That host gets the Responses API, where luna takes tools with reasoning:
#   OPENROUTER_BASE_URL=https://api.openai.com/v1
#   OPENROUTER_MODEL=gpt-6-luna
#   OPENROUTER_REASONING_EFFORT=low
# Through OpenRouter instead, pin the host: OPENROUTER_PROVIDER=OpenAI.
# OPENROUTER_SERVICE_TIER=flex halves the OpenAI price but slows replies,
# so do not read latency off a flex run.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PROVIDER=
OPENROUTER_REASONING_EFFORT=
OPENROUTER_SERVICE_TIER=

# OpenRouter asks for these on every request.
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=systems-learning-lab-shopkeeper

# Local Phoenix. Not a secret. Counter still runs if this is down.
PHOENIX_OTLP=http://localhost:6006/v1/traces
